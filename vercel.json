{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "builds": [
    {
      "src": "api/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "landings/*.html",
      "use": "@vercel/static"
    },
    {
      "src": "en/*.html",
      "use": "@vercel/static"
    },
    {
      "src": "en/landings/*.html",
      "use": "@vercel/static"
    },
    {
      "src": "fr/*.html",
      "use": "@vercel/static"
    },
    {
      "src": "fr/landings/*.html",
      "use": "@vercel/static"
    },
    {
      "src": "it/*.html",
      "use": "@vercel/static"
    },
    {
      "src": "it/landings/*.html",
      "use": "@vercel/static"
    },
    {
      "src": "assets/**",
      "use": "@vercel/static"
    },
    {
      "src": "css/**",
      "use": "@vercel/static"
    },
    {
      "src": "js/**",
      "use": "@vercel/static"
    },
    {
      "src": "images/**",
      "use": "@vercel/static"
    },
    {
      "src": "img/**",
      "use": "@vercel/static"
    },
    {
      "src": "sitemap.xml",
      "use": "@vercel/static"
    },
    {
      "src": "robots.txt",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/ghl-webhook",
      "dest": "/api/ghl-webhook.js"
    },
    {
      "src": "/api/lead",
      "dest": "/api/lead.js"
    },
    {
      "src": "/api/ghl-event",
      "dest": "/api/ghl-event.js"
    },
    {
      "src": "/api/ai-advisor",
      "dest": "/api/ai-advisor.js"
    },
    {
      "src": "/api/health",
      "dest": "/api/health.js"
    },
    {
      "src": "/health",
      "dest": "/api/health.js"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "/js/$1"
    },
    {
      "src": "/css/(.*)",
      "dest": "/css/$1"
    },
    {
      "src": "/images/(.*)",
      "dest": "/images/$1"
    },
    {
      "src": "/img/(.*)",
      "dest": "/img/$1"
    },
    {
      "src": "/en/landings/([a-zA-Z0-9_-]+)",
      "dest": "/en/landings/$1.html"
    },
    {
      "src": "/fr/landings/([a-zA-Z0-9_-]+)",
      "dest": "/fr/landings/$1.html"
    },
    {
      "src": "/it/landings/([a-zA-Z0-9_-]+)",
      "dest": "/it/landings/$1.html"
    },
    {
      "src": "/landings/([a-zA-Z0-9_-]+)",
      "dest": "/landings/$1.html"
    },
    {
      "src": "/landings/(.*)",
      "dest": "/landings/$1"
    },
    {
      "src": "/en/?$",
      "dest": "/en/index.html"
    },
    {
      "src": "/en/([a-zA-Z0-9_-]+)",
      "dest": "/en/$1.html"
    },
    {
      "src": "/fr/?$",
      "dest": "/fr/index.html"
    },
    {
      "src": "/fr/([a-zA-Z0-9_-]+)",
      "dest": "/fr/$1.html"
    },
    {
      "src": "/it/?$",
      "dest": "/it/index.html"
    },
    {
      "src": "/it/([a-zA-Z0-9_-]+)",
      "dest": "/it/$1.html"
    },
    {
      "src": "/sitemap.xml",
      "dest": "/sitemap.xml"
    },
    {
      "src": "/robots.txt",
      "dest": "/robots.txt"
    },
    {
      "src": "/favicon.ico",
      "dest": "/assets/logo.svg"
    },
    {
      "src": "/([a-zA-Z0-9_-]+)",
      "dest": "/$1.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}